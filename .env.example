# Set only after approving content and confirming your HTTPS canonical domain.
SITE_URL=
SITE_INDEXABLE=false
# Server only. Verify this sender/domain with Resend. Never use NEXT_PUBLIC_ for secrets.
RESEND_API_KEY=
INQUIRY_FROM=
INQUIRY_TO=
# Upstash Redis REST endpoint/token: required for distributed spam limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use your hosting platform's trusted, overwritten client IP header.
# Vercel: x-vercel-forwarded-for. Other platforms: configure a trusted proxy.
INQUIRY_IP_HEADER=x-vercel-forwarded-for
# Optional verified public alternatives (non-secret):
NEXT_PUBLIC_CONTACT_EMAIL=aytechservices13@gmail.com
NEXT_PUBLIC_WHATSAPP_NUMBER=2348169378718
# Optional owner-managed project/video editor (public dataset; no API write token on website).
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Actual editor URL after deployment (.vercel.app or .sanity.studio).
SANITY_STUDIO_URL=

# Simple uploader at /manage (replaces Sanity for routine publishing).
# Connect a PUBLIC Vercel Blob store in the Vercel Storage tab; it supplies this token.
BLOB_READ_WRITE_TOKEN=
# Server-only: set a strong, unique owner password in Vercel, never in source control.
OWNER_PASSWORD=
# Random 48-byte hex signing secret. Set separately from the password.
OWNER_SESSION_SECRET=
# Connect a PRIVATE Vercel Blob store with prefix PROJECTS for project records.
PROJECTS_READ_WRITE_TOKEN=
