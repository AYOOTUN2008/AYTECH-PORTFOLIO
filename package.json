{
  "name": "aytech-creative",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && node --import tsx --test tests/*.test.tsx",
    "test:e2e": "node tests/browser.mjs",
    "cms:dev": "npm --prefix studio run dev",
    "cms:build": "npm --prefix studio run build",
    "cms:check": "tsc --noEmit --project studio/tsconfig.json",
    "test:media": "node tests/media-browser.mjs",
    "test:motion": "node tests/motion-browser.mjs",
    "test:categories": "node tests/category-browser.mjs",
    "test:manager": "node tests/simple-manager-browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@vercel/blob": "^2.8.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lighthouse": "^13.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  }
}
